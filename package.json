{
  "name": "funailog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "author": "paveg_",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "preview": "astro preview",
    "astro": "astro",
    "prebuild": "tsx src/utils/clean.ts",
    "build": "astro build && rm -rf dist/styleguide dist/CLAUDE",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test",
    "prelint": "astro sync",
    "lint": "run-p --aggregate-output --continue-on-error \"lint:*\"",
    "lint:astro": "astro check",
    "lint:content": "tsx scripts/validate-content.ts",
    "lint:eslint": "eslint --cache .",
    "lint:format": "prettier --check .",
    "lint:knip": "knip --include files,dependencies,unlisted",
    "lint:md": "markdownlint-cli2",
    "lint:textlint": "textlint \"src/content/blog/**/*.mdx\" \"src/content/page/**/*.mdx\"",
    "lint:types": "tsc --noEmit",
    "fix": "run-s fix:format fix:eslint fix:md fix:textlint",
    "fix:eslint": "eslint --cache --fix .",
    "fix:format": "prettier --write .",
    "fix:md": "markdownlint-cli2 --fix",
    "fix:textlint": "textlint --fix \"src/content/blog/**/*.mdx\" \"src/content/page/**/*.mdx\"",
    "cv": "tsx scripts/generate-cv.ts",
    "cv:en": "tsx scripts/generate-cv.ts --en",
    "link-cards:warm": "tsx scripts/link-cards.ts warm",
    "link-cards:prune": "tsx scripts/link-cards.ts prune",
    "link-cards:list": "tsx scripts/link-cards.ts list",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,astro,js,mjs}": [
      "eslint --cache --fix"
    ],
    "*.{md,mdx}": [
      "markdownlint-cli2 --fix"
    ],
    "src/content/blog/**/*.mdx": [
      "tsx scripts/validate-content.ts"
    ],
    "*.{ts,tsx,astro,js,mjs,css,md,mdx,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource/line-seed-jp": "5.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@react-pdf/renderer": "^4.3.1",
    "@tailwindcss/vite": "4.3.3",
    "astro": "^7.4.2",
    "astro-embed": "0.14.0",
    "budoux": "0.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-hierarchy": "3.1.2",
    "framer-motion": "12.38.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-mermaid": "3.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "schema-dts": "^1.1.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "ip-address@<10.5.1": "^10.5.1",
      "markdown-it@<14.3.3": "^14.3.3",
      "js-yaml@<4.3.2": "^4.3.2",
      "esbuild@<0.28.1": "^0.28.1",
      "fflate@<0.7.5": "^0.7.5",
      "postcss-selector-parser@<7.1.6": "^7.1.6",
      "katex@<0.18.2": "^0.18.2",
      "zod@<4.6.6": "^4.6.6"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.6.3",
    "@types/d3-hierarchy": "3.1.7",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "astro-expressive-code": "0.44.2",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-astro": "^0.33.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "fetch-site-metadata": "^0.2.0",
    "hastscript": "^9.0.1",
    "husky": "^9.1.7",
    "knip": "6.14.1",
    "lightningcss": "^1.30.2",
    "lint-staged": "^15.2.10",
    "markdownlint-cli2": "^0.20.0",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "npm-run-all2": "9.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.13.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-parse": "9.0.1",
    "rehype-stringify": "10.0.1",
    "satori": "^0.33.5",
    "sharp": "^0.35.4",
    "textlint": "^15.5.4",
    "textlint-plugin-mdx": "^1.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "unist-util-visit-parents": "6.0.2",
    "vitest": "4.1.12",
    "yaml": "^2.8.2"
  },
  "packageManager": "pnpm@10.25.0+sha512.5e82639027af37cf832061bcc6d639c219634488e0f2baebe785028a793de7b525ffcd3f7ff574f5e9860654e098fe852ba8ac5dd5cefe1767d23a020a92f501"
}
